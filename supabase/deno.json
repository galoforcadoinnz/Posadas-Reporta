{
  "imports": {
    "@imagemagick/magick-wasm": "npm:@imagemagick/magick-wasm@0.0.43",
    "@std/assert": "jsr:@std/assert@1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.112.0"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom", "dom.iterable"],
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "include": ["functions/"]
  },
  "tasks": {
    "check": "deno fmt --check functions/ && deno lint functions/ && deno test functions/tests/ --allow-env"
  }
}
